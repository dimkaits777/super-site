# ──────────────────────────────────────────────────────────────
# «Кокос» — environment variables.
# Copy this file to `.env` and adjust. Only VITE_* vars reach the
# client bundle. Never commit real secrets — `.env` is gitignored.
# ──────────────────────────────────────────────────────────────

# Telegram ordering bot — the primary call-to-action across the site.
VITE_TELEGRAM_BOT_URL="https://t.me/ai_cocos_bot"

# Public contact details (used in the legal documents & footer).
VITE_CONTACT_EMAIL="info@kokos.cafe"
VITE_INSTAGRAM_URL="https://www.instagram.com/coffe_cocoss"
VITE_FACEBOOK_URL="https://www.facebook.com/share/18zfsAgQLi/"

# Optional: override the 3D cake model path.
# Defaults to the generated opaque hashed asset in /public/models.
# VITE_CAKE_MODEL_URL="/models/xxxxxxxx.glb"
